{
  "name": "jsontool",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server/main.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "node server/main.js",
    "dev": "node --watch server/main.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/smoke.test.js tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/smoke.test.js tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:mutation": "stryker run",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "playwright": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturiliushchits/jsontool.git"
  },
  "author": "Artur Iliushchits",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arturiliushchits/jsontool/issues"
  },
  "homepage": "https://github.com/arturiliushchits/jsontool#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.2.1"
  }
}
